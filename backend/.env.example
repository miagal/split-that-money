LOG_LEVEL=INFO
THIRD_PARTY_LOG_LEVEL=WARNING
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false

# --- Plain Vite on HTTP ---
#   Open http://localhost:5173 or http://<LAN-IP>:5173.
#   Do not set APP_DOMAIN / APP_HOST.
ALLOWED_HOSTS=localhost,127.0.0.1,
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# --- Domain-feeling Vite behind your TLS reverse proxy ---
#   Django will derive hosts/CSRF from APP_DOMAIN (LOCAL_CA_SETUP=false).
#   Start Vite with: DEV_DOMAIN=stm-dev.<YOUR-DOMAIN>.com npm run dev
# APP_DOMAIN=stm-dev.<YOUR-DOMAIN>.com
# APP_HOST=127.0.0.1
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

DATABASE_NAME=split_that_money.sqlite3
ALLOW_SELF_REGISTRATION=true
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
BOOTSTRAP_ADMIN_PASSWORD=admin123$
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=User
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE_DAYS=30
SHELL_NETWORK_TIMEOUT_SECONDS=3
SYNC_REQUEST_TIMEOUT_SECONDS=8
